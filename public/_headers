# Read by Cloudflare Pages (and Netlify). Other hosts simply ignore this file.
# Header values from several matching rules are merged, so each rule sets different headers.
/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# The entry page must always be re-checked, so a new deploy shows up on the next visit.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# Hashed build files never change: cache them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
